# =============================================================================
# MeetMind AI — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to version control.
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://meetmind:meetmind_dev@localhost:5432/meetmind_ai
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=meetmind_dev
POSTGRES_DB=meetmind_ai

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j (Community Edition) ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=meetmind_neo4j_dev

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Clerk Authentication ────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── Multi-Tenancy ───────────────────────────────────────────────────────────
DEFAULT_TENANT_ID=default

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
