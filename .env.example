# =============================================================================
# MeetMind AI -- Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to version control.
# =============================================================================

# -- Neon (Managed Serverless Postgres) ----------------------------------------
# Both dev and prod use Neon. Create a Neon project, then:
#   - For local dev: use the "dev" branch connection string
#   - For production: create a "prod" branch from the same project
# This keeps schema migrations traceable across both environments.
#
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
NEON_DATABASE_URL=postgresql://meetmind:REPLACE_ME@ep-REPLACE-ME.us-east-2.aws.neon.tech/meetmind_ai?sslmode=require

# -- Redis ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- Neo4j (Community Edition) -------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=meetmind_neo4j_dev

# -- Qdrant --------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# -- Clerk Authentication ------------------------------------------------------
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# -- Multi-Tenancy -------------------------------------------------------------
DEFAULT_TENANT_ID=default

# -- Application ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=DEBUG