# =============================================================================
# MeetMind AI -- Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to version control.
# =============================================================================

# -- Neon (Managed Serverless Postgres) ----------------------------------------
# Both dev and prod use Neon. Create a Neon project, then:
#   - For local dev: use the "dev" branch connection string
#   - For production: create a "prod" branch from the same project
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
NEON_DATABASE_URL=postgresql://meetmind:REPLACE_ME@ep-REPLACE-ME.neon.tech/meetmind_ai?sslmode=require
NEON_APP_DATABASE_URL=postgresql://meetmind_app:REPLACE_ME@ep-REPLACE-ME-pooler.neon.tech/meetmind_ai?sslmode=require

# -- Test Branch DSNs (Optional, for isolated integration testing) -------------
# NEON_TEST_DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-test.neon.tech/meetmind_ai?sslmode=require
# NEON_TEST_APP_DATABASE_URL=postgresql://meetmind_app:REPLACE_ME@ep-test-pooler.neon.tech/meetmind_ai?sslmode=require

# -- Redis ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- Neo4j (Community Edition) -------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=meetmind_neo4j_dev

# -- Qdrant --------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# -- Clerk Authentication ------------------------------------------------------
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_JWKS_URL=https://<clerk-domain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<clerk-domain>.clerk.accounts.dev
# ALLOWED_ORIGINS must be a valid JSON list of origins (wildcard '*' forbidden in prod)
ALLOWED_ORIGINS=["https://app.meetmind.ai"]
# Mapping of Clerk Organization IDs to MeetMind Tenant IDs (JSON object)
TENANT_ORG_MAP={"org_REPLACE_ME": "default"}
# Elevated role set for WebSocket listener permission (JSON list of role strings)
ELEVATED_LISTEN_ROLES=["org:admin"]

# -- Multi-Tenancy -------------------------------------------------------------
DEFAULT_TENANT_ID=default

# -- Application ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=DEBUG
